#!/bin/sh
# Repository commit checks. Installed with: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)"
fail=0
paths="schema shopkit clients migrations"
if ! git diff --quiet -- $paths || [ -n "$(git ls-files --others --exclude-standard -- $paths)" ]; then
  echo "pre-commit: part of the change is not staged ($paths); stage the whole change"
  fail=1
fi
if git diff --cached --name-only | grep -qx 'schema/models.yaml' \
  && ! git diff --cached -U0 -- CHANGES.md | grep -q '^+[-*] '; then
  echo "pre-commit: schema/models.yaml changed without an entry in CHANGES.md under '## Unreleased'"
  fail=1
fi
if git diff --cached --name-only | grep -qx 'clients/python/shopkit_client.py' \
  && ! git diff --cached --name-only | grep -qx 'clients/python/VERSION'; then
  echo "pre-commit: clients/python/shopkit_client.py changed; bump clients/python/VERSION (minor for a new field)"
  fail=1
fi
python3 tools/check.py || fail=1
[ "$fail" -eq 0 ] || echo "pre-commit: commit rejected"
exit "$fail"
