# Claude Code's Anthropic-compatible endpoint and model.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Evolve's reflection LLM (independent of Claude's task model).
EVOLVE_CUSTOM_LLM_PROVIDER=openai
EVOLVE_MODEL_NAME=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# For a gateway serving both APIs, replace both URLs, both keys, and both
# model names with your gateway values. Example model: Azure/gpt-4.1.
# Set the OpenAI URL to https://YOUR-GATEWAY/v1 and the Anthropic URL to
# https://YOUR-GATEWAY (without /v1). No host Claude login is used.
