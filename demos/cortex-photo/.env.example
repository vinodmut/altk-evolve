# Claude Code's Anthropic-compatible endpoint and model.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Evolve uses the same Anthropic connection and Sonnet model by default.
# For a stronger learner, select an available Opus model here; keep the
# Claude Code task model fixed for the comparison.
EVOLVE_CUSTOM_LLM_PROVIDER=anthropic
EVOLVE_MODEL_NAME=claude-sonnet-4-6

# For a gateway serving the Anthropic API, replace ANTHROPIC_BASE_URL,
# ANTHROPIC_API_KEY, and both model IDs with your gateway values.
# Example: ANTHROPIC_MODEL=aws/claude-sonnet-4-5 and
# EVOLVE_MODEL_NAME=aws/claude-sonnet-4-5. No host Claude login is used.
#
# If reflection instead uses your gateway's OpenAI-compatible API, set:
# EVOLVE_CUSTOM_LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://YOUR-GATEWAY/v1
# OPENAI_API_KEY=
# Keep EVOLVE_MODEL_NAME set to the Claude model offered by that gateway.
