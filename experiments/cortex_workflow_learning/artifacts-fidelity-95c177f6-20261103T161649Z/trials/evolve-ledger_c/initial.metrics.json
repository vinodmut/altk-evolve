    "python3 -c \"import json\nfrom datetime import datetime, timezone\nrows = json.load(open('ledger.json'))\n# Step 1: Collapse by event_id with highest revision\nevent_map = {}\nfor row in rows:\n    eid = row['event_id']\n    rev = row['revision']\n    if eid not in event_map or rev > event_map[eid]['revision']:\n        event_map[eid] = row\n# Step 2: Filter for settled, production, July 2026 events\nfirst_day = datetime(2026, 7, 1, tzinfo=timezone.utc)\nnext_month = datetime(2026, 8, 1, tzinfo=timezone.utc)\nfiltered = []\nfor r in event_map.values():\n    if r['status'] == 'settled' and r['customer_id'] == 'account-204':\n        occ = datetime.fromisoformat(r['occurred_at'].replace('Z', '+00:00'))\n        if first_day <= occ < next_month:\n            filtered.append(r)\n# Step 3: Calculate totals_minor by currency\n# Add captures, subtract refunds\ntotals_minor = {}\nfor r in filtered:\n    cur = r['currency']\n    amt = r['amount_minor'] if r['kind'] == 'capture' else -r['amount_minor']\n    totals_minor[cur] = totals_minor.get(cur, 0) + amt\n# Step 4: Collect sorted distinct included_event_ids\nincluded_event_ids = sorted(set(r['event_id'] for r in filtered))\nout = {'totals_minor': totals_minor, 'included_event_ids': included_event_ids}\nwith open('report.json','w') as f:\n    json.dump(out, f)\nprint(json.dumps(out, indent=2))\""
