    "python3 -c \"import json; from dateutil.parser import isoparse; from collections import defaultdict\n\nwith open('orchid-ledger.json') as f:\n    rows = json.load(f)\n\n# Collapse by event_id: keep only highest revision\nlatest = {}\nfor r in rows:\n    eid = r['event_id']\n    rev = r['revision']\n    if eid not in latest or rev > latest[eid]['revision']:\n        latest[eid] = r\n\n# Account settings\naccount_id = 'account-203'\n\n# UTC time boundaries for June 2026\nstart = isoparse('2026-06-01T00:00:00Z')\nend = isoparse('2026-07-01T00:00:00Z')\n\ndef in_june_2026(dt):\n    dt = isoparse(dt).astimezone(start.tzinfo)\n    return start <= dt < end\n\n# Only settled\nselected = [r for r in latest.values()\n    if r['customer_id']==account_id\n    and r['status']=='settled'\n    and in_june_2026(r['occurred_at'])]\n\n# Aggregate net revenue per currency\nnet = defaultdict(int)\nevent_ids = set()\nfor r in selected:\n    eid = r['event_id']\n    amt = r['amount_minor']\n    curr = r['currency']\n    if r['kind']=='capture':\n        net[curr] += amt\n    elif r['kind']=='refund':\n        net[curr] -= amt\n    event_ids.add(eid)\n\nout = {'totals_minor': dict(net),\n       'included_event_ids': sorted(event_ids)}\nwith open('report.json','w') as f:\n    json.dump(out, f, indent=2)\nprint(json.dumps(out, indent=2))\""
