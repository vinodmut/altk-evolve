    "python3 -c \"import json; import sys; from datetime import datetime, timezone; from dateutil.parser import isoparse; ledger = json.load(open('ledger.json')); events = {}; start = datetime(2026, 7, 1, 0, 0, 0, tzinfo=timezone.utc); end = datetime(2026, 8, 1, 0, 0, 0, tzinfo=timezone.utc); for row in ledger: event_id = row['event_id']; revision = row['revision']; if event_id not in events or revision > events[event_id]['revision']: events[event_id] = row; filtered = [e for e in events.values() if e['customer_id'] == 'account-204' and e['status']=='settled']; filtered = [e for e in filtered if (isoparse(e['occurred_at']).astimezone(timezone.utc) >= start and isoparse(e['occurred_at']).astimezone(timezone.utc) < end)]; totals = {}; included_event_ids = set(); for e in filtered: c = e['currency']; amt = e['amount_minor']; if e['kind'] == 'capture': totals[c] = totals.get(c,0)+amt; elif e['kind']=='refund': totals[c] = totals.get(c,0)-amt; included_event_ids.add(e['event_id']); result = {'totals_minor': {k: totals[k] for k in sorted(totals)}, 'included_event_ids': sorted(included_event_ids)}; json.dump(result, open('report.json','w')); print(json.dumps(result))\"",
    "python3 reconcile.py > report.json && cat report.json",
    "python3 -c '\nimport json\nfrom datetime import datetime, timezone\nfrom dateutil.parser import isoparse\n# Load ledger\nwith open(\"ledger.json\") as f:\n    ledger = json.load(f)\n# Step 1: Collapse by event_id, keeping max revision\nevents = {}\nfor row in ledger:\n    eid = row[\"event_id\"]\n    rev = row[\"revision\"]\n    if eid not in events or rev > events[eid][\"revision\"]:\n        events[eid] = row\n# Step 2: Filter production customer and settled rows\nfiltered = [e for e in events.values() if e[\"customer_id\"]==\"account-204\" and e[\"status\"]==\"settled\"]\n# Step 3: Filter by UTC July 2026\nstart = datetime(2026,7,1,0,0,0, tzinfo=timezone.utc)\nend = datetime(2026,8,1,0,0,0, tzinfo=timezone.utc)\nfiltered = [e for e in filtered if (isoparse(e[\"occurred_at\"]).astimezone(timezone.utc) >= start and isoparse(e[\"occurred_at\"]).astimezone(timezone.utc) < end)]\n# Step 4: Sum net amount_minor per currency, add/subtract captures/refunds\nresult = {\"totals_minor\":{}, \"included_event_ids\":[]}\ntotals = {}\nidset = set()\nfor e in filtered:\n    cur = e[\"currency\"]\n    amt = e[\"amount_minor\"]\n    if e[\"kind\"]==\"capture\":\n        totals[cur] = totals.get(cur,0)+amt\n    elif e[\"kind\"]==\"refund\":\n        totals[cur] = totals.get(cur,0)-amt\n    idset.add(e[\"event_id\"])\nresult[\"totals_minor\"] = {k:totals[k] for k in sorted(totals)}\nresult[\"included_event_ids\"] = sorted(idset)\nwith open(\"report.json\",\"w\") as f:\n    json.dump(result, f)\nprint(json.dumps(result))\n'"
