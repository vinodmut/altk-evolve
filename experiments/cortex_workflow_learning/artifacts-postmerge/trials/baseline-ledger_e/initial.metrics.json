    "python3 -c '\nimport json\nfrom datetime import datetime, timezone\nimport pytz\n\nwith open(\"ledger.json\") as f:\n    rows = json.load(f)\n\n# Revenue contract logic\n# 1. Collapse rows by event_id using the greatest numeric revision across the entire export\nlatest_by_event = {}\nfor row in rows:\n    eid = row[\"event_id\"]\n    rev = row[\"revision\"]\n    if eid not in latest_by_event or rev > latest_by_event[eid][\"revision\"]:\n        latest_by_event[eid] = row\n\n# 2. Only Summit Labs production, only settled\n# 3. Select month boundaries in UTC\n#   2026-09: occurred_at >= 2026-09-01T00:00:00Z and occurred_at < 2026-10-01T00:00:00Z\nSTART = datetime(2026, 9, 1, 0, 0, 0, tzinfo=timezone.utc)\nEND = datetime(2026, 10, 1, 0, 0, 0, tzinfo=timezone.utc)\n\ndef in_range(dt_str):\n    dt = datetime.fromisoformat(dt_str.replace(\"Z\", \"+00:00\"))\n    return START <= dt and dt < END\n\nfiltered = [\n    row for row in latest_by_event.values()\n    if row[\"customer_id\"] == \"account-206\"\n    and row[\"status\"] == \"settled\"\n    and in_range(row[\"occurred_at\"])\n]\n\n# 4. Sum by currency, add captures, subtract refunds\nfrom collections import defaultdict\n\ntotals_minor = defaultdict(int)\nfor row in filtered:\n    sign = 1 if row[\"kind\"] == \"capture\" else -1\n    totals_minor[row[\"currency\"]] += sign * row[\"amount_minor\"]\n\nincluded_event_ids = sorted(set(row[\"event_id\"] for row in filtered))\n\nout = {\n    \"totals_minor\": dict(totals_minor),\n    \"included_event_ids\": included_event_ids\n}\n\nwith open(\"report.json\", \"w\") as f:\n    json.dump(out, f, indent=2)\n'",
