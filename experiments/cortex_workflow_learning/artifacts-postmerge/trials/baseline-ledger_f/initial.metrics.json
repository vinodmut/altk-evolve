    "python3 <<EOF\nimport json\nfrom datetime import datetime, timezone, timedelta\nimport dateutil.parser\n\nwith open('willow-works-ledger.json') as f:\n    rows = json.load(f)\n\n# Contract setup\ntime_min = 1790812800  # 2026-10-01T00:00:00Z\ntime_max = 1793491200  # 2026-11-01T00:00:00Z\nprod_customer = 'account-207'\n\n# 1. Keep greatest revision row for each event_id\nlatest = {}\nfor row in rows:\n    eid = row['event_id']\n    rev = row['revision']\n    if eid not in latest or rev > latest[eid]['revision']:\n        latest[eid] = row\n\n# 2. Only use production customer\nfiltered = [r for r in latest.values() if r['customer_id'] == prod_customer]\n\n# 3. Only settled\nfiltered = [r for r in filtered if r['status'] == 'settled']\n\n# 4. Parse occurred_at -> UTC timestamp; only those within bounds\nselected = []\nfor r in filtered:\n    # dateutil handles all offsets per contract\n    dt = dateutil.parser.isoparse(r['occurred_at']).astimezone(timezone.utc)\n    ts = int(dt.timestamp())\n    if ts >= time_min and ts < time_max:\n        selected.append(r)\n\n# 5. Amount handling\n# for each currency, sum captures and subtract refunds\nfrom collections import defaultdict\nnet_minor = defaultdict(int)\nevent_ids = set()\nfor r in selected:\n    cur = r['currency']\n    eid = r['event_id']\n    amt = r['amount_minor']\n    event_ids.add(eid)\n    # Refund events subtract\n    if r['kind'] == 'refund':\n        net_minor[cur] -= amt\n    elif r['kind'] == 'capture':\n        net_minor[cur] += amt\n\nresult = {\n    'totals_minor': dict(net_minor),\n    'included_event_ids': sorted(event_ids)\n}\n\nwith open('report.json','w') as f:\n    json.dump(result, f, indent=2)\nprint(json.dumps(result, indent=2))\nEOF"
