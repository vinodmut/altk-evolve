      "cat ledger2026-05.json",
      "python3 ops.py revenue-contract",
      "python3 -c '\nimport json\nfrom datetime import datetime, timezone\n\nwith open(\"ledger2026-05.json\") as f:\n    ledger = json.load(f)\n\n# Step 1: Find the greatest revision per event_id across the entire export\nmax_revision = {}\nfor row in ledger:\n    eid = row[\"event_id\"]\n    rev = row[\"revision\"]\n    if eid not in max_revision or rev > max_revision[eid]:\n        max_revision[eid] = rev\n\n# Step 2: Collapse rows by event_id using only the greatest revision. Ignore lower revisions.\ncollapsed = {}\nfor row in ledger:\n    eid = row[\"event_id\"]\n    if row[\"revision\"] == max_revision[eid]:\n        collapsed[eid] = row  # last matching revision wins\n\n# Step 3: Only production account id\nenv_id = \"account-202\"\ncollapsed = [v for v in collapsed.values() if v[\"customer_id\"] == env_id]\n\n# Step 4: Only status=settled\ncollapsed = [v for v in collapsed if v[\"status\"] == \"settled\"]\n\n# Step 5: Filter date range boundaries\n# 2026-05-01T00:00:00Z <= occurred_at < 2026-06-01T00:00:00Z\nstart_utc = datetime(2026,5,1,0,0,0,tzinfo=timezone.utc)\nend_utc = datetime(2026,6,1,0,0,0,tzinfo=timezone.utc)\n\ndef parse_dt(d):\n    try:\n        return datetime.fromisoformat(d.replace(\"Z\", \"+00:00\"))\n    except Exception:\n        return datetime.strptime(d, \"%Y-%m-%dT%H:%M:%S%z\")\n\ncollapsed = [v for v in collapsed if start_utc <= parse_dt(v[\"occurred_at\"]) < end_utc]\n\n# Step 6: Sum amount_minor per currency, refund is subtract, capture is add\ntotals_minor = {}\nincluded_event_ids = []\nfor v in collapsed:\n    cur = v[\"currency\"]\n    amt = v[\"amount_minor\"]\n    if v[\"kind\"] == \"refund\":\n        amt = -amt\n    if cur not in totals_minor:\n        totals_minor[cur] = 0\n    totals_minor[cur] += amt\n    included_event_ids.append(v[\"event_id\"])\n\nincluded_event_ids = sorted(list(set(included_event_ids)))\n\nresult = {\n    \"totals_minor\": totals_minor,\n    \"included_event_ids\": included_event_ids\n}\n\nwith open(\"report.json\", \"w\") as f:\n    json.dump(result, f, indent=2)\n'",
      "cat report.json"
    ],
